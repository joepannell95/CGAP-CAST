<div class="cgap-shipby" id="cgap-shipby">
  <div class="cgap-shipby__date"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 6h11v9H3zM14 9h4l3 3v3h-7zM6.5 18.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm11 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/></svg><span>Made to order and ships within 2 business days from Amory, MS</span></div>
  <ul class="cgap-shipby__trust"><li>Free shipping over $35</li><li>30-day returns</li><li>5-year outdoor warranty</li><li>POs and tax-exempt welcome</li></ul>
</div>
<style>
.cgap-shipby{margin:1.2rem 0 .2rem;font-size:1.35rem}
.cgap-shipby__date{display:flex;gap:.7rem;align-items:center;font-weight:600;color:#173F24}
.cgap-shipby__date svg{flex:none;color:#E0731A}
.cgap-shipby__trust{list-style:none;padding:0;margin:.7rem 0 0;display:flex;flex-wrap:wrap;gap:.4rem .8rem;font-size:1.2rem;color:rgba(var(--color-foreground),.75)}
.cgap-shipby__trust li:before{content:"\2713";color:#1f6b35;font-weight:700;margin-right:.35rem}
</style>
<script>
(function(){
  try{
    var el=document.querySelector('#cgap-shipby .cgap-shipby__date span'); if(!el) return;
    var p=new Intl.DateTimeFormat('en-US',{timeZone:'America/Chicago',year:'numeric',month:'numeric',day:'numeric'}).formatToParts(new Date());
    var g=function(t){return +p.find(function(x){return x.type===t}).value};
    var d=new Date(Date.UTC(g('year'),g('month')-1,g('day'),12));
    var hol={'2026-11-26':1,'2026-12-25':1,'2027-01-01':1,'2027-05-31':1,'2027-07-05':1,'2027-09-06':1,'2027-11-25':1,'2027-12-24':1};
    var key=function(x){return x.toISOString().slice(0,10)};
    var biz=function(x){var w=x.getUTCDay();return w>0&&w<6&&!hol[key(x)]};
    while(!biz(d)) d.setUTCDate(d.getUTCDate()+1);
    var n=0; while(n<2){d.setUTCDate(d.getUTCDate()+1); if(biz(d)) n++;}
    var s=d.toLocaleDateString('en-US',{timeZone:'UTC',weekday:'long',month:'short',day:'numeric'});
    el.textContent='Order today and it ships by '+s+' from Amory, MS';
  }catch(e){}
})();
</script>
{%- comment -%} Plan my site box for signs in a site-type collection. Rendered here, then moved below the description. {%- endcomment -%}
{%- if product -%}
<div id="cgap-plan-slot">{%- render 'cgap-plan-cta', mode: 'product', product: product -%}</div>
<script>
(function(){
  function mv(){
    var s=document.getElementById('cgap-plan-slot'); if(!s||!s.firstElementChild) return;
    var d=document.querySelector('.product__info-container .product__description');
    if(d&&d.parentNode){ d.parentNode.insertBefore(s, d.nextSibling); }
  }
  if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded', mv); } else { mv(); }
})();
</script>
{%- endif -%}
