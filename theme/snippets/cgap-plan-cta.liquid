        assign pf = 'mfg'
        assign pn = 'a manufacturing plant'
      when 'warehouse-and-distribution-center-signs', 'warehouse-sign-kits', 'warehouses-and-logistics-signs', 'loading-dock-warehouse-signs', 'forklift-pedestrian-signs', 'moving-company-signs'
