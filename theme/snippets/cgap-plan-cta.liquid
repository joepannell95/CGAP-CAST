      when 'propane-natural-gas-pipeline-safety-signs'
        assign pf = 'oil_chem'
        assign pn = 'a propane or gas site'
      when 'school-shop-class-theater-safety-signs'
        assign pf = 'school'
        assign pn = 'a school shop or theater'
      when 'data-center-server-room-safety-signs'
        assign pf = 'datacenter'
        assign pn = 'a data center or server room'
      when 'lithium-battery-energy-storage-ev-safety-signs'
        assign pf = 'utility'
        assign pn = 'a battery or EV charging site'
      when 'chemical-plant-storage-safety-signs'
        assign pf = 'oil_chem'
        assign pn = 'an oil, gas or chemical site'
      when 'mining-quarry-asphalt-plant-safety-signs'
        assign pf = 'quarry'
        assign pn = 'a quarry or mine'
      when 'industry-water-wastewater-utilities'
        assign pf = 'water'
        assign pn = 'a water or wastewater plant'
      when 'industry-electric-telecom-utilities'
