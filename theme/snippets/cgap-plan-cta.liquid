    elsif s contains 'gas station' or s contains 'truck stop' or s contains 'fuel station' or s contains 'fuel terminal' or s contains 'fuel island' or s contains 'convenience store'
      assign pf = 'fuelstop'
    elsif s contains 'data center' or s contains 'server room'
