      if t contains 'Sector: '
        assign s = t | remove_first: 'Sector: ' | downcase | prepend: ' ' | append: ' '
        break
      endif
    endfor
    if s != ''
    if s contains 'marina' or s contains 'boatyard' or s contains 'boat ramp' or s contains 'dock and pier' or s contains 'harbor' or s contains 'yacht' or s contains 'waterfront'
      assign pf = 'marina'
    elsif s contains 'car wash' or s contains 'detailing'
