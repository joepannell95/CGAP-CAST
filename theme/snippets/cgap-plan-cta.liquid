      when 'construction-site-safety-signs'
        assign pf = 'construction'
        assign pn = 'a construction site'
      when 'food-processing-plant-safety-signs'
        assign pf = 'mfg'
        assign pn = 'a food processing plant'
      when 'oil-gas-hydrogen-safety-signs'
