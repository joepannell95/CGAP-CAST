    "who_we_build_for": {
      "type": "custom-liquid",
      "name": "Who we build for",
      "settings": {
        "custom_liquid": "<style>.wb{max-width:1200px;margin:0 auto;padding:0 20px}.wb h2{text-align:center;font-size:1.6rem;margin:0 0 6px}.wb p.sub{text-align:center;color:#555;margin:0 auto 26px;max-width:62ch}.wb-grid{display:grid;grid-template-columns:1fr;gap:12px}@media(min-width:750px){.wb-grid{grid-template-columns:1fr 1fr}}@media(min-width:990px){.wb-grid{grid-template-columns:repeat(4,1fr)}}.wb a{display:block;padding:18px 18px 16px;border:1px solid #e3e3e3;border-top:4px solid #1c5e3a;text-decoration:none;color:#121212;background:#fff;transition:border-color .15s}.wb a:hover{border-color:#1c5e3a}.wb b{display:block;font-size:1.02rem;margin-bottom:6px}.wb span{display:block;font-size:.9rem;color:#555;line-height:1.45}.wb em{display:block;margin-top:10px;font-style:normal;font-size:.85rem;font-weight:700;color:#1c5e3a}</style><div class='wb'><h2>Who we build for</h2><p class='sub'>Each of these pages walks a site the way an inspector would: what has to be posted, under which standard, and which sign covers it.</p><div class='wb-grid'><a href='/pages/industry-electric-telecom-utilities'><b>Electric &amp; Telecom Utilities</b><span>Substations, buried plant, vaults, pedestals, battery rooms, towers. The industry we came from.</span><em>Read the page</em></a><a href='/pages/industry-water-wastewater-utilities'><b>Water &amp; Wastewater</b><span>Lift stations, H2S, chlorine rooms, digesters, basins, force mains. A confined space program and a chemical program on one site.</span><em>Read the page</em></a><a href='/pages/industry-municipalities-public-works'><b>Municipalities &amp; Public Works</b><span>Manholes, retention ponds, fleet yards, parks, right-of-way. Half the audience never saw the training.</span><em>Read the page</em></a><a href='/pages/industry-healthcare-imaging-labs'><b>Hospitals, Imaging &amp; Labs</b><span>MRI zones, radiation areas, infection control, hazardous drugs. Non-ferromagnetic by necessity.</span><em>Read the page</em></a><a href='/pages/industry-manufacturing-industrial-plants'><b>Manufacturing &amp; Plants</b><span>Machine guarding, LOTO, regulated areas, arc flash, and the process hazards generic catalogs skip.</span><em>Read the page</em></a><a href='/pages/industry-warehousing-logistics'><b>Warehousing &amp; Logistics</b><span>Dock edges, trailer creep, forklift lanes, charging areas, automation, cold storage.</span><em>Read the page</em></a><a href='/pages/industry-marinas-waterfront'><b>Marinas &amp; Waterfront</b><span>Electric shock drowning, drop-offs, intakes, mooring, fuel docks. Signs that live on a piling.</span><em>Read the page</em></a><a href='/pages/industry-property-management-multifamily'><b>Property Management &amp; Campuses</b><span>E-bike charging, pools, mechanical rooms, grounds, egress. Policy made visible.</span><em>Read the page</em></a></div></div>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 24
      }
    },
    "shop_by_hazard": {
      "type": "custom-liquid",
      "name": "Shop by Hazard",
      "settings": {
        "custom_liquid": "<style>.hz{max-width:1200px;margin:0 auto;padding:0 20px}.hz h2{text-align:center;font-size:1.6rem;margin:0 0 6px}.hz p.sub{text-align:center;color:#555;margin:0 0 28px}.hz-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}@media(min-width:750px){.hz-grid{grid-template-columns:repeat(4,1fr)}}@media(min-width:990px){.hz-grid{grid-template-columns:repeat(6,1fr)}}.hz a{display:flex;flex-direction:column;align-items:center;gap:10px;padding:18px 10px;border:1px solid #e3e3e3;text-decoration:none;color:#121212;background:#fff;transition:border-color .15s}.hz a:hover{border-color:#C8102E}.hz svg{width:52px;height:52px;stroke:#C8102E;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}.hz span{font-size:.85rem;font-weight:600;text-align:center;line-height:1.2}.hz a.hz-all{grid-column:span 2;flex-direction:row;justify-content:center;background:#121212;border-color:#121212;color:#fff}.hz a.hz-all:hover{border-color:#C8102E}.hz a.hz-all svg{stroke:#fff;width:40px;height:40px}.hz a.hz-all span{font-size:1rem;color:#fff}@media(min-width:990px){.hz a.hz-all{grid-column:span 4}}</style><div class='hz'><h2>Shop by hazard</h2><p class='sub'>Every sign is 8x12 rust-resistant aluminum, UV-stable ink, pre-drilled. Made in the USA.</p><div class='hz-grid'><a href='/collections/water-waterfront-safety-signs'><svg viewBox='0 0 48 48'><path d='M4 34c4 0 4-3 8-3s4 3 8 3 4-3 8-3 4 3 8 3 4-3 8-3'/><path d='M4 41c4 0 4-3 8-3s4 3 8 3 4-3 8-3 4 3 8 3 4-3 8-3'/><circle cx='24' cy='14' r='4'/><path d='M24 18v8M16 22l8-4 8 4'/></svg><span>Water &amp; Waterfront</span></a><a href='/collections/mri-safety-signs'><svg viewBox='0 0 48 48'><circle cx='24' cy='24' r='17'/><circle cx='24' cy='24' r='8'/><path d='M24 7v6M24 35v6M7 24h6M35 24h6'/></svg><span>MRI Safety</span></a><a href='/collections/call-811-before-digging-signs'><svg viewBox='0 0 48 48'><path d='M4 20h40'/><path d='M8 30h32M8 38h32'/><path d='M14 20V9h20v11'/><path d='M19 9V5h10v4'/><text x='24' y='36' font-size='7' font-weight='700' text-anchor='middle' fill='#C8102E' stroke='none'>811</text></svg><span>Call 811 Buried Utility</span></a><a href='/collections/battery-energy-storage-signs'><svg viewBox='0 0 48 48'><rect x='8' y='14' width='30' height='20' rx='2'/><path d='M38 20h4v8h-4'/><path d='M25 17l-5 8h6l-4 8'/></svg><span>Battery &amp; Energy Storage</span></a><a href='/collections/high-voltage-signs'><svg viewBox='0 0 48 48'><path d='M24 5L4 41h40z'/><path d='M26 17l-6 10h7l-5 9'/></svg><span>High Voltage</span></a><a href='/collections/arc-flash-signs'><svg viewBox='0 0 48 48'><path d='M24 6v8M24 34v8M6 24h8M34 24h8M11 11l6 6M31 31l6 6M37 11l-6 6M17 31l-6 6'/><circle cx='24' cy='24' r='5'/></svg><span>Arc Flash</span></a><a href='/collections/confined-space-signs'><svg viewBox='0 0 48 48'><ellipse cx='24' cy='12' rx='16' ry='5'/><path d='M8 12v22c0 3 7 5 16 5s16-2 16-5V12'/><path d='M24 18v14M19 27l5 5 5-5'/></svg><span>Confined Space</span></a><a href='/collections/loading-dock-warehouse-signs'><svg viewBox='0 0 48 48'><path d='M4 30h20V14h18v16'/><path d='M4 30v10h40V30'/><circle cx='12' cy='36' r='3'/><circle cx='34' cy='36' r='3'/><path d='M24 30l-6-6'/></svg><span>Loading Dock</span></a><a href='/collections/laser-safety-signs'><svg viewBox='0 0 48 48'><path d='M4 24h30'/><path d='M34 24l6-6M34 24l6 6M34 24l8 0M34 24l4-9M34 24l4 9'/><circle cx='34' cy='24' r='2'/></svg><span>Laser</span></a><a href='/collections/radiation-safety-signs'><svg viewBox='0 0 48 48'><circle cx='24' cy='24' r='4'/><path d='M24 8a16 16 0 0 1 14 8l-7 4a8 8 0 0 0-7-4z'/><path d='M10 16a16 16 0 0 1 14-8v8a8 8 0 0 0-7 4z'/><path d='M24 40a16 16 0 0 1-14-8l7-4a8 8 0 0 0 14 0l7 4a16 16 0 0 1-14 8z'/></svg><span>Radiation</span></a><a href='/collections/hydrogen-sulfide-h2s-signs'><svg viewBox='0 0 48 48'><path d='M14 30a7 7 0 0 1 1-14 9 9 0 0 1 17 2 6 6 0 0 1 2 12z'/><path d='M16 36v4M24 36v6M32 36v4'/></svg><span>H2S &amp; Toxic Gas</span></a><a href='/collect