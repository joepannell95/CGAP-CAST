{%- unless product.type == 'Safety Sign Kit' -%}
<div class="cgap-kitcard" id="cgap-kitcard" data-handle="{{ product.handle }}" data-base="{{ 'cgap-kitmap-00.json' | asset_url }}">
  <div class="cgap-kitcard__exact" hidden></div>
  {%- if kh != blank and collections[kh].products_count > 0 -%}
  <div class="cgap-kitcard__ind">
    <div class="cgap-kitcard__eyebrow">Signing a whole site?</div>
    <p class="cgap-kitcard__lead">{{ kl }} sign kits put every sign one area needs in one order, at 10 to 15% under single-sign prices.</p>
    <ul>{%- for k in collections[kh].products limit: 3 -%}<li><a href="{{ k.url }}">{{ k.title | split: ' Safety Sign Kit' | first }} kit</a> <span>{{ k.price | money }}</span></li>{%- endfor -%}</ul>
    <a class="cgap-kitcard__all" href="{{ collections[kh].url }}">All {{ collections[kh].products_count }} {{ kl }} kits</a>
  </div>
  {%- endif -%}
</div>
<style>
.cgap-kitcard{margin:1.6rem 0 .4rem}
.cgap-kitcard__exact,.cgap-kitcard__ind{border:1px solid rgba(var(--color-foreground),.15);border-radius:6px;padding:1.2rem 1.4rem;margin-bottom:1rem}
.cgap-kitcard__exact{border-color:#E0731A;background:#fff8f2;display:flex;gap:1.2rem;align-items:center}
.cgap-kitcard__exact img{width:84px;height:84px;object-fit:contain;background:#fff;border:1px solid #eee;border-radius:4px;flex:none}
.cgap-kitcard__eyebrow{font-size:1.15rem;letter-spacing:.07em;text-transform:uppercase;font-weight:700;color:#173F24;margin-bottom:.3rem}
.cgap-kitcard__lead{font-size:1.35rem;margin:0 0 .6rem;line-height:1.45}
.cgap-kitcard ul{list-style:none;margin:0 0 .6rem;padding:0;font-size:1.35rem;line-height:1.9}
.cgap-kitcard li{display:flex;justify-content:space-between;gap:1rem;border-bottom:1px dashed rgba(var(--color-foreground),.12)}
.cgap-kitcard li span{font-weight:600;white-space:nowrap}
.cgap-kitcard a{color:inherit}
.cgap-kitcard__all{font-size:1.3rem;font-weight:700;text-decoration:underline}
.cgap-kitcard__exact b{display:block;font-size:1.45rem;line-height:1.35;margin:.1rem 0 .3rem}
.cgap-kitcard__exact .btn{display:inline-block;margin-top:.5rem;padding:.6rem 1.2rem;background:#173F24;color:#fff;border-radius:4px;font-size:1.3rem;font-weight:700;text-decoration:none}
</style>
<script>
(function(){
  var el=document.getElementById('cgap-kitcard'); if(!el) return;
  var h=el.dataset.handle, base=el.dataset.base;
  function crc32(s){var c,crc=0xFFFFFFFF;for(var i=0;i<s.length;i++){c=(crc^s.charCodeAt(i))&0xFF;for(var k=0;k<8;k++)c=c&1?(c>>>1)^0xEDB88320:c>>>1;crc=(crc>>>8)^c;}return (crc^0xFFFFFFFF)>>>0;}
  var n=('0'+(crc32(h)%32)).slice(-2);
  fetch(base.replace('cgap-kitmap-00.json','cgap-kitmap-'+n+'.json')).then(function(r){return r.ok?r.json():{}}).then(function(m){
    var ks=m[h]; if(!ks||!ks.length) return;
    return fetch('/products/'+ks[0]+'.js').then(function(r){return r.ok?r.json():null}).then(function(k){
      if(!k) return;
      var box=el.querySelector('.cgap-kitcard__exact');
      var cnt=(k.title.match(/(\d+) Signs/)||[])[1];
      var name=k.title.split(' Safety Sign Kit')[0];
      var price=(k.price/100).toLocaleString('en-US',{style:'currency',currency:'USD'});
      var img=k.featured_image?k.featured_image+(k.featured_image.indexOf('?')>-1?'&':'?')+'width=200':'';
      box.innerHTML=(img?'<img src="'+img+'" alt="" loading="lazy">':'')+'<div><div class="cgap-kitcard__eyebrow">This sign is part of a kit</div><b>'+name+' Sign Kit'+(cnt?', '+cnt+' signs':'')+'</b><span>'+price+' for the full set</span><br><a class="btn" href="/products/'+k.handle+'">See the kit</a></div>';
      box.hidden=false;
    });
  }).catch(function(){});
})();
</script>
{%- endunless -%}
