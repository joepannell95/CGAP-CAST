      ...d.custom.map((c) => ({ item: `${c.header} custom sign: ${c.text}`, sub: 'Made to your wording, proof before production', area: c.area || 'General', qty: c.qty })),
    ];
    const C = { n: M, item: M + 22, area: M + 290, qty: M + 432, unit: M + 480, amt: W - M };
    const head = () => {
      doc.setFillColor(238, 244, 239); doc.rect(M, y, W - 2 * M, 20, 'F');
      color(G); doc.setFont('helvetica', 'bold'); doc.setFontSize(8.5);
      doc.text('#', C.n + 4, y + 13); doc.text('ITEM', C.item, y + 13); doc.text('AREA', C.area, y + 13);
      doc.text('QTY', C.qty, y + 13, { align: 'right' }); doc.text('UNIT', C.unit, y + 13, { align: 'right' }); doc.text('AMOUNT', C.amt, y + 13, { align: 'right' });
      y += 26; doc.setFont('helvetica', 'normal');
    };
    y += 14; head();
    items.forEach((it, i) => {
      doc.setFontSize(9.5);
      const il = doc.splitTextToSize(clean(it.item), 260), al = doc.splitTextToSize(clean(it.area), 128);
      const hgt = Math.max(il.length * 12 + 11, al.length * 11) + 8;
      if (y + hgt > H - 70) { doc.addPage(); y = 50; head(); doc.setFontSize(9.5); }
      color(MUT); doc.text(String(i + 1), C.n + 4, y + 2);
      color(INK); doc.text(il, C.item, y + 2);
      color(MUT); doc.setFontSize(7.5); doc.text(clean(it.sub).slice(0, 70), C.item, y + 2 + il.length * 12);
      doc.setFontSize(8.5); doc.text(al, C.area, y + 2);
      doc.setFontSize(9.5); color(INK);
