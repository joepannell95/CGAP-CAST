    const a = fetch(API, { method: 'POST', body: JSON.stringify(body) }).then((r) => r.json()).catch(() => ({ ok: false }));
    // Also send through the store contact form so the owner gets an email with the plan.
    const fd = new FormData();
    fd.append('form_type', 'contact'); fd.append('utf8', '✓');
    fd.append('contact[email]', info.email); if (info.name) fd.append('contact[name]', info.name);
    if (info.phone) fd.append('contact[phone]', info.phone);
    fd.append('contact[body]', `[${kind === 'quote' ? 'QUOTE / PO REQUEST' : 'SAVED SIGN PLAN'}]\n` + (info.company ? 'Company: ' + info.company + '\n' : '') + (info.note ? 'Notes: ' + info.note + '\n' : '') + '\n' + planText(d));
    const b = fetch('/contact#contact_form', { method: 'POST', body: fd, credentials: 'same-origin' }).catch(() => null);
    const [r] = await Promise.all([a, b]);
    return r && r.ok;
  }

