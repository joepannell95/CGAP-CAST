    await Promise.all(live.map(async (r) => { if (!r.v) { const p = await product(M.signs[r.alts[r.i]].h); const v = p && p.variants && p.variants.find((x) => x.available); r.v = v ? v.id : false; } }));
    const items = live.filter((r) => r.v).map((r) => ({ id: r.v, quantity: r.qty, properties: { _site_plan: fac().name } }));
    let missing = 0;
    if (st.custom.length) {
      const cp = CUSTOM ? await product(CUSTOM) : null; const cv = cp && cp.variants && cp.variants.find((x) => x.available);
      if (cv) st.custom.forEach((c) => items.push({ id: cv.id, quantity: c.qty, properties: { Header: c.header, Wording: c.text, Location: c.area || 'General', 'Designer notes': c.note || '' } }));
      else missing = st.custom.length;
    }
    try {
      for (let i = 0; i < items.length; i += 40) { const r = await fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: items.slice(i, i + 40) }) }); if (!r.ok) throw new Error(await r.text()); }
      if (missing) { openDlg(`<h3>Almost there</h3><p>Your catalog signs are in the cart. Custom signs can't be added online yet, so send them with a quote request and we'll invoice them with your order.</p><button class="sp-btn g" type="button" id="sp-q2">Send custom signs as a quote</button>`); $('#sp-q2').addEventListener('click', quoteDlg); return; }
      location.href = '/cart';
    } catch (e) {
      openDlg(`<h3>Some signs couldn't be added</h3><p>Part of your plan may already be in the cart. Request a quote and we'll put the full order together for you.</p><button class="sp-btn g" type="button" id="sp-q2">Request a quote</button>`); $('#sp-q2').addEventListener('click', quoteDlg);
    } finally { btn.disabled = false; refresh(); }
  }
  bar.addEventListener('click', (e) => { const a = e.target.closest('[data-act]'); if (!a) return; if (a.dataset.act === 'cart') toCart(); else if (a.dataset.act === 'quote') quoteDlg(); else pdfDlg(); });

  const planUrl = API + '?action=plan' + (ADMIN ? '&cid=' + ADMIN.cid + '&ts=' + ADMIN.ts + '&sig=' + ADMIN.sig : '');
  fetch(planUrl).then((r) => r.json()).then((d) => {
    if (!d || !d.facilities) throw new Error('no plan data');
    M = d; (d.pins || []).forEach((x) => PINS.add(pinKey(x.fac, x.k, x.sku))); readUrl(); if (st.step === 3) build(); show(st.step);
  }).catch(() => { main.innerHTML = `<div class="sp-card"><h2>The plan builder is busy</h2><p class="s">Refresh in a moment, or <a href="/pages/contact">tell us about your site</a> and we'll build the plan for you.</p></div>`; });
})();
</script>

