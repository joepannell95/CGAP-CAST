{%- comment -%} CGAP Site Sign Plan: short questionnaire that builds a room-by-room sign plan, then cart / quote / printable plan {%- endcomment -%}
<link rel="preconnect" href="https://esmwoaqemeukjrjaesby.supabase.co">
<style>
  .sp{--g:#173F24;--g2:#0d2615;--o:#E0731A;--ink:#14181a;--mut:#5d6660;--ln:#e3e6e0;--bg:#f5f6f2;font-family:var(--font-body-family);color:var(--ink);background:var(--bg)}
  .sp *{box-sizing:border-box}
  .sp-hd{background:linear-gradient(155deg,var(--g),var(--g2));color:#fff;position:relative;overflow:hidden}
  .sp-hd:before{content:"";position:absolute;inset:0;background-image:repeating-linear-gradient(-45deg,rgba(255,255,255,.035) 0 14px,transparent 14px 28px)}
  .sp-hd-in{position:relative;max-width:1180px;margin:0 auto;padding:4.4rem 2.4rem 3.6rem}
  .sp-eb{display:inline-flex;align-items:center;gap:1rem;font-size:1.2rem;letter-spacing:.18em;text-transform:uppercase;font-weight:700;color:#f7c79f}
  .sp-eb i{width:28px;height:4px;background:var(--o)}
  .sp-hd h1{font-family:var(--font-heading-family);text-transform:uppercase;font-size:clamp(3rem,4.4vw,5.2rem);line-height:1.02;margin:1rem 0;color:#fff}
  .sp-hd p{font-size:1.7rem;opacity:.9;max-width:720px;margin:0;line-height:1.5}
  .sp-steps{display:flex;gap:.6rem;margin-top:2.4rem;flex-wrap:wrap}
  .sp-steps span{font-size:1.25rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:.7rem 1.3rem;border-radius:40px;border:1px solid rgba(255,255,255,.25);opacity:.6}
  .sp-steps span.on{opacity:1;background:var(--o);border-color:var(--o)}
  .sp-steps span.done{opacity:1}
  .sp-stripe{height:8px;background:repeating-linear-gradient(-45deg,#111 0 14px,#FFD100 14px 28px)}
  .sp-main{max-width:1180px;margin:0 auto;padding:3.2rem 2.4rem 14rem}
  .sp-card{background:#fff;border:1px solid var(--ln);border-radius:10px;padding:2.6rem;box-shadow:0 6px 24px rgba(20,24,26,.05)}
  .sp-card h2{font-family:var(--font-heading-family);text-transform:uppercase;font-size:2.4rem;margin:0 0 .4rem;color:var(--g)}
  .sp-card>p.s{color:var(--mut);font-size:1.5rem;margin:0 0 2rem}
  .sp-fac{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}
  .sp-fac button{all:unset;cursor:pointer;border:2px solid var(--ln);border-radius:8px;padding:1.6rem 1.4rem;font-weight:700;font-size:1.5rem;line-height:1.3;display:flex;gap:1rem;align-items:center;transition:all .15s;background:#fff}
  .sp-fac button i{flex:none;width:12px;height:12px;background:var(--o);transform:rotate(45deg)}
  .sp-fac button:hover{border-color:var(--o);background:#fff7f0}
  .sp-fac button[aria-pressed=true]{border-color:var(--g);background:#eef4ef;box-shadow:inset 0 0 0 1px var(--g)}
  .sp-areas{display:grid;grid-template-columns:repeat(2,1fr);gap:.9rem}
  .sp-area{display:flex;align-items:center;gap:1.2rem;border:2px solid var(--ln);border-radius:8px;padding:1.1rem 1.3rem;background:#fff;transition:border-color .15s}
  .sp-area.on{border-color:var(--g);background:#f4f8f4}
  .sp-area label{flex:1;display:flex;align-items:center;gap:1rem;cursor:pointer;font-weight:700;font-size:1.45rem;line-height:1.3}
  .sp-area input[type=checkbox]{width:2rem;height:2rem;accent-color:var(--g);flex:none;margin:0}
  .sp-area small{display:block;font-weight:400;color:var(--mut);font-size:1.2rem}
  .sp-qty{display:inline-flex;align-items:center;border:1px solid #cfd4cc;border-radius:6px;overflow:hidden;flex:none;background:#fff}
  .sp-qty button{all:unset;cursor:pointer;width:3.2rem;height:3.2rem;display:flex;align-items:center;justify-content:center;font-size:1.8rem;font-weight:700;color:var(--g)}
  .sp-qty button:hover{background:#eef2ec}
  .sp-qty span{min-width:3rem;text-align:center;font-weight:800;font-size:1.45rem}
  .sp-area:not(.on) .sp-qty{opacity:.35;pointer-events:none}
  .sp-more{margin-top:1.6rem}
  .sp-more summary{cursor:pointer;font-weight:700;color:var(--g);font-size:1.45rem;padding:.6rem 0}
  .sp-more .sp-areas{margin-top:1rem}
  .sp-site{display:flex;gap:2rem;flex-wrap:wrap;margin:0 0 2.2rem;padding:1.6rem;border-radius:8px;background:var(--bg)}
  .sp-site>div{display:flex;align-items:center;gap:1.2rem;font-weight:700;font-size:1.45rem}
  .sp-site small{display:block;color:var(--mut);font-weight:400;font-size:1.2rem}
  .sp-nav{display:flex;justify-content:space-between;align-items:center;margin-top:2.4rem;gap:1rem}
  .sp-btn{all:unset;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:.8rem;background:var(--o);color:#fff;font-family:var(--font-heading-family);text-transform:uppercase;letter-spacing:.06em;font-size:1.6rem;padding:1.4rem 2.6rem;border-radius:7px;transition:background .15s;text-align:center}
  .sp-btn:hover{background:#c55f0e}
  .sp-btn.g{background:var(--g)}.sp-btn.g:hover{background:#0f2b18}
  .sp-btn.w{background:#fff;color:var(--g);box-shadow:inset 0 0 0 2px var(--g)}.sp-btn.w:hover{background:#eef4ef}
  .sp-btn[disabled]{opacity:.45;pointer-events:none}
  .sp-link{all:unset;cursor:pointer;color:var(--g);font-weight:700;font-size:1.4rem;text-decoration:underline}
  .sp-sum{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin:0 0 2rem}
  .sp-sum div{background:#fff;border:1px solid var(--ln);border-radius:8px;padding:1.4rem 1.6rem}
  .sp-sum b{display:block;font-family:var(--font-heading-family);font-size:2.8rem;line-height:1;color:var(--g)}
  .sp-sum small{font-size:1.15rem;letter-spacing:.1em;text-transform:uppercase;color:var(--mut)}
  .sp-nudge{background:#fff7f0;border:1px solid #f3c9a3;border-radius:8px;padding:1.2rem 1.6rem;margin:0 0 2rem;font-size:1.45rem;display:flex;gap:1rem;align-items:center;flex-wrap:wrap}
  .sp-nudge b{color:#a54d06}
  .sp-grp{background:#fff;border:1px solid var(--ln);border-radius:10px;margin:0 0 1.6rem;overflow:hidden}
  .sp-grp-h{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1.4rem 1.8rem;background:#f9faf7;border-bottom:1px solid var(--ln)}
  .sp-grp-h h3{margin:0;font-family:var(--font-heading-family);text-transform:uppercase;font-size:1.8rem;color:var(--g)}
  .sp-grp-h span{font-size:1.3rem;color:var(--mut)}
  .sp-row{display:grid;grid-template-columns:96px minmax(0,1fr) auto auto;gap:1.6rem;align-items:center;padding:1.3rem 1.8rem;border-bottom:1px solid #eef0ec}
  .sp-row:last-child{border-bottom:0}
  .sp-row.off{opacity:.45}
  .sp-th{width:96px;height:64px;border:1px solid var(--ln);border-radius:4px;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative}
  .sp-th img{width:100%;height:100%;object-fit:contain;opacity:0;transition:opacity .2s}
  .sp-th img.ok{opacity:1}
  .sp-th .ph{position:absolute;inset:6px;border-radius:2px;display:flex;align-items:flex-start;justify-content:center;font:900 9px/1.6 Arial,sans-serif;color:#fff}
  .sp-th img.ok+.ph{display:none}
  .sp-tx{min-width:0}
  .sp-tx .k{font-size:1.15rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);font-weight:700}
  .sp-tx a{display:block;font-weight:800;font-size:1.55rem;color:var(--ink);text-decoration:none;line-height:1.3;margin:.2rem 0}
  .sp-tx a:hover{color:var(--o)}
  .sp-tx .m{font-size:1.25rem;color:var(--mut);display:flex;gap:1.2rem;flex-wrap:wrap;align-items:center}
  .sp-tag{font-size:1rem;font-weight:800;letter-spacing:.08em;padding:.2rem .6rem;border-radius:2px}
  .sp-acts{display:flex;gap:.6rem;align-items:center}
  .sp-ic{all:unset;cursor:pointer;font-size:1.25rem;font-weight:700;color:var(--g);padding:.6rem .9rem;border-radius:5px;border:1px solid #d5dad2;white-space:nowrap}
  .sp-ic:hover{border-color:var(--o);color:var(--o)}
  .sp-custom{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1.2rem 1.8rem;background:#fcfcfa;font-size:1.35rem;color:var(--mut);flex-wrap:wrap}
  .sp-bar{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:3px solid var(--o);box-shadow:0 -10px 40px rgba(0,0,0,.14);z-index:60;transform:translateY(110%);transition:transform .3s}
  .sp-bar.on{transform:none}
  .sp-bar-in{max-width:1180px;margin:0 auto;padding:1.4rem 2.4rem;display:flex;align-items:center;gap:1.6rem;flex-wrap:wrap}
  .sp-bar .tot{flex:1;min-width:220px}
  .sp-bar .tot b{font-family:var(--font-heading-family);font-size:2.6rem;color:var(--g)}
  .sp-bar .tot small{display:block;font-size:1.25rem;color:var(--mut)}
  .sp-bar .sp-btn{padding:1.2rem 2rem;font-size:1.45rem}
  .sp-modal{position:fixed;inset:0;background:rgba(10,20,14,.55);z-index:80;display:none;align-items:center;justify-content:center;padding:1.6rem}
  .sp-modal.on{display:flex}
  .sp-dlg{background:#fff;border-radius:10px;max-width:560px;width:100%;max-height:92vh;overflow:auto;padding:2.6rem;position:relative}
  .sp-dlg h3{font-family:var(--font-heading-family);text-transform:uppercase;color:var(--g);font-size:2.2rem;margin:0 0 .6rem}
  .sp-dlg p{color:var(--mut);font-size:1.45rem;margin:0 0 1.6rem}
  .sp-dlg .x{all:unset;cursor:pointer;position:absolute;right:1.4rem;top:1.2rem;font-size:2.6rem;line-height:1;color:var(--mut)}
  .sp-f{display:block;margin:0 0 1.2rem}
  .sp-f span{display:block;font-weight:700;font-size:1.3rem;margin:0 0 .4rem}
  .sp-f input,.sp-f textarea,.sp-f select{width:100%;border:1px solid #cfd4cc;border-radius:6px;padding:1.1rem 1.2rem;font:inherit;font-size:1.5rem;background:#fff;color:var(--ink)}
  .sp-f textarea{min-height:90px;resize:vertical}
  .sp-2{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
  .sp-ok{background:#eef4ef;border:1px solid #bcd3c1;border-radius:8px;padding:1.4rem;font-size:1.45rem;color:var(--g);font-weight:700}
  .sp-err{color:#b3261e;font-size:1.3rem;margin:.4rem 0 0;min-height:1.6rem}
  .sp-prev{border:1px solid var(--ln);border-radius:6px;padding:1.2rem;text-align:center;margin:0 0 1.4rem}
  .sp-prev .h{font:900 2rem/1 Arial,sans-serif;padding:.8rem;color:#fff;border-radius:3px 3px 0 0}
  .sp-prev .b{font:800 1.6rem/1.25 Arial,sans-serif;text-transform:uppercase;padding:1.4rem .8rem;min-height:80px;border:2px solid #222;border-top:0}
  .sp-load{padding:4rem;text-align:center;color:var(--mut);font-size:1.5rem}
  .sp-adm{display:flex;gap:.5rem;flex-wrap:wrap;grid-column:1/-1;padding:.8rem 1rem;margin-top:.4rem;background:#fff8e6;border:1px dashed #e2b04a;border-radius:6px;font-size:1.2rem;align-items:center}
  .sp-adm b{color:#8a5a00;margin-right:.4rem}
  .sp-adm .on{background:#173F24;color:#fff;border-color:#173F24}
  .sp-adm-bn{background:#fff8e6;border:1px solid #e2b04a;border-radius:8px;padding:1.2rem 1.6rem;margin:0 0 1.6rem;font-size:1.4rem}
  .sp-res{max-height:50vh;overflow:auto;border:1px solid var(--ln);border-radius:6px}
  .sp-res button{all:unset;cursor:pointer;display:block;width:100%;box-sizing:border-box;padding:1rem 1.2rem;border-bottom:1px solid #eef0ec;font-size:1.4rem}
  .sp-res button:hover{background:#f6f7f4}
  .sp-res small{display:block;color:var(--mut);font-size:1.15rem}
  .sp-h3{font-family:var(--font-heading-family);text-transform:uppercase;font-size:1.6rem;letter-spacing:.04em;color:var(--g);margin:2.6rem 0 1rem}
  .sp-h3:first-of-type{margin-top:0}
  .sp-goals{display:grid;grid-template-columns:repeat(3,1fr);gap:.9rem}
  .sp-goals button,.sp-chips button{all:unset;cursor:pointer;box-sizing:border-box;border:2px solid var(--ln);border-radius:8px;padding:1.3rem 1.4rem;background:#fff;transition:all .15s}
  .sp-goals button b{display:block;font-size:1.5rem;line-height:1.3}
  .sp-goals button small{display:block;color:var(--mut);font-size:1.25rem;line-height:1.4;margin-top:.3rem}
  .sp-goals button:hover,.sp-chips button:hover{border-color:var(--o)}
  .sp-goals button[aria-pressed=true],.sp-chips button[aria-pressed=true]{border-color:var(--g);background:#eef4ef;box-shadow:inset 0 0 0 1px var(--g)}
  .sp-chips{display:flex;flex-wrap:wrap;gap:.8rem}
  .sp-chips button{padding:1rem 1.6rem;font-weight:700;font-size:1.4rem;border-radius:40px}
  .sp-qs{display:grid;grid-template-columns:repeat(2,1fr);gap:.9rem}
  .sp-q{display:flex;align-items:center;gap:1.2rem;border:1px solid var(--ln);border-radius:8px;padding:1.1rem 1.3rem;background:#fff}
  .sp-q>span{flex:1;font-weight:700;font-size:1.42rem;line-height:1.3}
  .sp-q small{display:block;font-weight:400;color:var(--mut);font-size:1.2rem;line-height:1.4;margin-top:.2rem}
  .sp-yn{display:inline-flex;border:1px solid #cfd4cc;border-radius:6px;overflow:hidden;flex:none}
  .sp-yn button{all:unset;cursor:pointer;padding:.7rem 1.3rem;font-weight:700;font-size:1.3rem;color:var(--g)}
  .sp-yn button[aria-pressed=true]{background:var(--g);color:#fff}
  .sp-pri{font-size:1rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding:.2rem .6rem;border-radius:2px;border:1px solid}
  .sp-pri.p1{background:#fdecea;color:#9b1c13;border-color:#f2b8b3}
  .sp-pri.p2{background:#eef4ef;color:var(--g);border-color:#bcd3c1}
  .sp-pri.p3{background:#f4f4f1;color:#5d6660;border-color:#dcdfd8}
  .sp-why{grid-column:1/-1;background:#f9faf7;border-left:3px solid var(--o);padding:.9rem 1.2rem;font-size:1.3rem;line-height:1.5;color:#333;border-radius:0 6px 6px 0}
  .sp-why b{color:var(--g)}
  .sp-tools{display:flex;gap:.8rem;flex-wrap:wrap;align-items:center;margin:0 0 1.6rem;font-size:1.35rem;color:var(--mut)}
  .sp-banner{background:#eef4ef;border:1px solid #bcd3c1;border-radius:8px;padding:1.3rem 1.6rem;margin:0 0 1.6rem;font-size:1.45rem;line-height:1.5}
  .sp-banner b{color:var(--g)}
  #sp-print{display:none}
  @media (max-width:989px){
    .sp-fac{grid-template-columns:1fr 1fr}
    .sp-goals,.sp-qs{grid-template-columns:1fr}
    .sp-q{flex-wrap:wrap}
    .sp-areas{grid-template-columns:1fr}
    .sp-sum{grid-template-columns:1fr 1fr}
    .sp-row{grid-template-columns:72px minmax(0,1fr);gap:1rem;padding:1.2rem}
    .sp-th{width:72px;height:50px}
    .sp-row .sp-qty,.sp-row .sp-acts{grid-column:2}
    .sp-row .sp-acts{justify-content:flex-start}
    .sp-card{padding:1.8rem}
    .sp-bar-in{padding:1rem 1.2rem;gap:.8rem}
    .sp-bar .tot{flex-basis:100%}
    .sp-bar .sp-btn{flex:1;padding:1.1rem .8rem;font-size:1.2rem}
    .sp-2{grid-template-columns:1fr}
  }
  @media print{
    body *{visibility:hidden!important}
    #sp-print,#sp-print *{visibility:visible!important}
    #sp-print{display:block!important;position:absolute;left:0;top:0;width:100%;font-family:Arial,sans-serif;color:#111;font-size:11pt}
    #sp-print h1{font-size:20pt;margin:0 0 4pt}
    #sp-print h2{font-size:13pt;margin:14pt 0 4pt;border-bottom:2px solid #173F24;padding-bottom:2pt;color:#173F24}
    #sp-print table{width:100%;border-collapse:collapse}
    #sp-print td,#sp-print th{border:1px solid #bbb;padding:4pt 5pt;text-align:left;vertical-align:top}
    #sp-print th{background:#eee}
    #sp-print tr{page-break-inside:avoid}
    #sp-print .meta{color:#444;margin:0 0 8pt}
    #sp-print .box{width:12pt;height:12pt;border:1px solid #333;display:inline-block}
  }
</style>

<div class="sp" id="sp">
  <header class="sp-hd">
    <div class="sp-hd-in">
      <div class="sp-eb"><i></i>{{ section.settings.eyebrow }}</div>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
      <div class="sp-steps" id="sp-steps"><span data-s="0">1. Your site</span><span data-s="1">2. Site details</span><span data-s="2">3. Your areas</span><span data-s="3">4. Your sign plan</span></div>
    </div>
    <div class="sp-stripe"></div>
  </header>
  <div class="sp-main" id="sp-main"><div class="sp-load">Loading the plan builder...</div></div>
</div>

<div class="sp-bar" id="sp-bar"><div class="sp-bar-in">
  <div class="tot"><b id="sp-bt">$0.00</b><small id="sp-bs"></small></div>
  <button class="sp-btn w" type="button" data-act="pdf">Save or print plan</button>
  <button class="sp-btn g" type="button" data-act="quote">Get quote (PDF)</button>
  <button class="sp-btn" type="button" data-act="cart" id="sp-cartbtn">Add all to cart</button>
</div></div>

<div class="sp-modal" id="sp-modal" role="dialog" aria-modal="true"><div class="sp-dlg" id="sp-dlg"></div></div>
<div id="sp-print"></div>

{%- if customer and customer.tags contains 'cgap-admin' and section.settings.admin_secret != blank -%}
  {%- assign sp_ts = 'now' | date: '%s' -%}
  {%- capture sp_msg -%}{{ customer.id }}:{{ sp_ts }}{%- endcapture -%}
  <script>window.CGAP_PIN = { cid: {{ customer.id | json }}, ts: {{ sp_ts | json }}, sig: {{ sp_msg | hmac_sha256: section.settings.admin_secret | json }} };</script>
{%- endif -%}
<script>
(() => {
  const API = {{ section.settings.api_url | json }};
  const CUSTOM = {{ section.settings.custom_handle | json }};
  const STORE = {{ shop.name | json }};
  const TIERS = [[20, 23.99], [10, 25.49], [5, 26.99], [1, 29.99]];
  const BASE = 29.99;
  const QUOTE_AT = 5000;
  const SER = { 'DANGER': ['#C8102E', '#fff'], 'WARNING': ['#F47B20', '#111'], 'CAUTION': ['#FFD100', '#111'], 'NOTICE': ['#005EB8', '#fff'], 'SAFETY FIRST': ['#00843D', '#fff'] };
  const SCOPE = { site: 'One for the site', entrance: 'One at each entrance', area: 'One at each area' };
  const $ = (s, r = document) => r.querySelector(s);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const money = (n) => '$' + n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  const unit = (q) => { for (const [min, p] of TIERS) if (q >= min) return p; return BASE; };
  const next = (q) => { const t = [...TIERS].reverse().find(([min]) => min > q); return t ? { need: t[0] - q, price: t[1] } : null; };
  const main = $('#sp-main'), bar = $('#sp-bar'), modal = $('#sp-modal'), dlg = $('#sp-dlg');
  const prod = new Map();
  const product = (h) => { if (!prod.has(h)) prod.set(h, fetch('/products/' + encodeURIComponent(h) + '.js').then((r) => (r.ok ? r.json() : null)).catch(() => null)); return prod.get(h); };

  const ADMIN = window.CGAP_PIN || null;
  let M = null, PINS = new Set();
  const pinKey = (f, k, sku) => f + '|' + k + '|' + sku;
  const GOALS = [
    ['new', 'Outfitting a new or empty site', 'Every sign the site needs, from the door in.'],
    ['inspect', 'Getting ready for an inspection', 'Code-cited signs first. Extras start switched off.'],
    ['audit', 'Fixing audit or insurance findings', 'Close the gaps with code-cited and recommended signs.'],
    ['replace', 'Replacing faded or missing signs', 'A full list to check against what is on the walls.'],
    ['expand', 'Adding a new area or line', 'Plan just the new space. Uncheck the rest next step.'],
  ];
  const BUDGETS = [[0, 'No limit'], [500, 'Under $500 (P-card)'], [2500, 'Under $2,500'], [5000, 'Under $5,000']];
  const PRI = { 1: ['p1', 'Code-cited'], 2: ['p2', 'Recommended'], 3: ['p3', 'Good practice'] };
  const st = { step: 0, fac: null, goal: 'new', budget: 0, ans: {}, areas: {}, entrances: 1, rows: [], custom: [], cut: 0, onlyReq: false };

  // URL state so a plan can be shared or reopened: ?f=warehouse&g=inspect&b=500&q=ext.6,dock.4&a=forklift.2,dock.3&e=2
  function readUrl() {
    const u = new URLSearchParams(location.search);
    const f = u.get('f'); if (f && M.facilities.some((x) => x.code === f)) { st.fac = f; st.step = 1; defaults(); }
    const g = u.get('g'); if (g && GOALS.some((x) => x[0] === g)) st.goal = g;
    const b = Number(u.get('b')); if (BUDGETS.some((x) => x[0] === b)) st.budget = b;
