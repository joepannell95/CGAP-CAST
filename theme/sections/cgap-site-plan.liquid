    doc.setFont('helvetica', 'normal'); doc.setFontSize(9.5);
    doc.text('Quote no. ' + qn, W - M, 60, { align: 'right' }); doc.text('Date: ' + fdt(now), W - M, 74, { align: 'right' });
    // Prepared for / quote details
    let y = 118;
    color(MUT); doc.setFontSize(8); doc.setFont('helvetica', 'bold'); doc.text('PREPARED FOR', M, y); doc.text('QUOTE DETAILS', 330, y);
    doc.setFont('helvetica', 'normal'); doc.setFontSize(10); color(INK);
    const who = [info.name, info.company, info.email, info.phone].filter(Boolean).map(clean);
    who.forEach((l, i) => doc.text(l, M, y + 16 + i * 14));
    const det = [['Valid through', fdt(until)], ['Site plan', clean(d.facility)], ['Signs', String(t.q)], ['Price per sign', money(u)]];
    det.forEach(([k, v], i) => { color(MUT); doc.text(k, 330, y + 16 + i * 14); color(INK); doc.text(v, W - M, y + 16 + i * 14, { align: 'right' }); });
    y += 16 + Math.max(who.length, det.length) * 14 + 4;
    if (info.note) { const nl = doc.splitTextToSize('Notes: ' + clean(info.note), W - 2 * M); color(MUT); doc.setFontSize(9); doc.text(nl, M, y + 6); y += nl.length * 12 + 6; doc.setFontSize(10); }
