  function planText(d) {
    const lines = [`Site sign plan: ${d.facility}`, `Plan link: ${d.url}`, `${d.signs} signs, ${money(d.unit)} each, est. ${money(d.total)}`, ''];
    d.rows.forEach((r) => lines.push(`${r.qty} x ${r.series} ${r.sign} (${r.area}: ${r.slot}) https://${location.host}/products/${r.handle}`));
    d.custom.forEach((c) => lines.push(`${c.qty} x CUSTOM ${c.header}: ${c.text}${c.area ? ' (' + c.area + ')' : ''}`));
