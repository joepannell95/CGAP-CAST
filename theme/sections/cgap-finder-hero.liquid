{%- comment -%} CGAP homepage hero: Sign Finder search with instant suggestions {%- endcomment -%}
<link rel="preconnect" href="https://esmwoaqemeukjrjaesby.supabase.co">
<style>
  .fh{--g:#173F24;--g2:#0d2615;--o:#E0731A;--ink:#14181a;--mut:#5d6660;position:relative;color:#fff;background:linear-gradient(155deg,var(--g) 0%,var(--g2) 100%);overflow:visible;font-family:var(--font-body-family);z-index:3}
  .fh *{box-sizing:border-box}
  .fh-bg{position:absolute;inset:0;overflow:hidden;pointer-events:none}
  .fh-bg:before{content:"";position:absolute;inset:0;background-image:repeating-linear-gradient(-45deg,rgba(255,255,255,.035) 0 14px,transparent 14px 28px)}
  .fh-bg:after{content:"";position:absolute;width:900px;height:900px;right:-260px;top:-380px;background:radial-gradient(circle,rgba(224,115,26,.28),transparent 62%)}
  .fh-stripe{position:absolute;left:0;right:0;bottom:0;height:8px;background:repeating-linear-gradient(-45deg,#111 0 14px,#FFD100 14px 28px);opacity:.95}
  .fh-in{position:relative;max-width:1240px;margin:0 auto;padding:3.8rem 2.4rem 4.6rem;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr);gap:4rem;align-items:center}
  .fh-eyebrow{display:inline-flex;align-items:center;gap:1rem;font-size:1.25rem;letter-spacing:.18em;text-transform:uppercase;font-weight:700;color:#f7c79f}
  .fh-eyebrow i{width:28px;height:4px;background:var(--o)}
  .fh h1{font-family:var(--font-heading-family);text-transform:uppercase;font-size:clamp(3rem,3.6vw,4.8rem);line-height:1.02;margin:1rem 0 1rem;color:#fff;letter-spacing:.005em}
  .fh h1 em{font-style:normal;color:var(--o)}
  .fh-sub{font-size:1.65rem;line-height:1.5;opacity:.9;margin:0 0 2.2rem;max-width:620px}
  .fh-search{position:relative}
  .fh-box{display:flex;background:#fff;border-radius:8px;box-shadow:0 22px 60px rgba(0,0,0,.4);border:3px solid transparent;transition:border-color .2s,box-shadow .2s}
  .fh-box:focus-within{border-color:var(--o);box-shadow:0 22px 70px rgba(224,115,26,.35)}
  .fh-box svg{flex:none;align-self:center;margin-left:2rem;color:#7c857f}
  .fh-input{flex:1;min-width:0;border:0;outline:0;background:transparent;font-size:2.1rem;padding:2.3rem 1.4rem;color:var(--ink);font-family:inherit}
  .fh-go{border:0;background:var(--o);color:#fff;font-family:var(--font-heading-family);text-transform:uppercase;letter-spacing:.08em;font-size:1.8rem;padding:0 3.4rem;cursor:pointer;border-radius:0 5px 5px 0;transition:background .15s}
  .fh-go:hover{background:#c55f0e}
  .fh-dd{position:absolute;left:0;right:0;top:calc(100% + 8px);background:#fff;color:var(--ink);border-radius:8px;box-shadow:0 24px 60px rgba(0,0,0,.35);overflow:hidden;display:none;z-index:20}
  .fh-dd.on{display:block}
  .fh-dd a{display:flex;gap:1.4rem;align-items:center;padding:1rem 1.4rem;text-decoration:none;color:inherit;border-bottom:1px solid #eef0ec}
  .fh-dd a.act,.fh-dd a:hover{background:#f6f7f4}
  .fh-th{width:64px;height:48px;flex:none;background:#fff;border:1px solid #e1e4de;display:flex;flex-direction:column;overflow:hidden;position:relative}
  .fh-th img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#fff;opacity:0;transition:opacity .2s}
  .fh-th img.ok{opacity:1}
  .fh-th .h{height:14px;font-size:8px;font-weight:900;text-align:center;line-height:14px;font-family:Arial,sans-serif}
  .fh-th .b{flex:1;font-size:5px;font-weight:800;text-align:center;line-height:1.15;padding:2px;font-family:Arial,sans-serif;text-transform:uppercase;color:#111}
  .fh-tx{flex:1;min-width:0}
  .fh-tx b{display:block;font-size:1.55rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .fh-tx small{display:block;font-size:1.2rem;color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .fh-tg{font-size:1rem;font-weight:800;letter-spacing:.08em;padding:.25rem .6rem;border-radius:2px;flex:none}
  .fh-dd .all{justify-content:space-between;background:var(--g);color:#fff;font-weight:700;font-size:1.45rem;border:0}
  .fh-dd .all:hover,.fh-dd .all.act{background:#0f2b18}
  .fh-dd .all span{color:#f7c79f}
  .fh-dd .hint{padding:1.2rem 1.4rem;font-size:1.35rem;color:var(--mut)}
  .fh-try{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.8rem;align-items:center}
  .fh-try>span{font-size:1.3rem;opacity:.7;margin-right:.2rem}
  .fh-try a{border:1px solid rgba(255,255,255,.3);background:rgba(255,255,255,.07);color:#fff;border-radius:40px;padding:.7rem 1.4rem;font-size:1.35rem;text-decoration:none;transition:all .15s}
  .fh-try a:hover{background:var(--o);border-color:var(--o)}
  .fh-stats{display:flex;gap:3.4rem;margin-top:2.4rem;flex-wrap:wrap}
  .fh-stats b{display:block;font-family:var(--font-heading-family);font-size:3.2rem;line-height:1;color:#fff}
  .fh-stats small{font-size:1.15rem;letter-spacing:.12em;text-transform:uppercase;opacity:.7}
  .fh-art{position:relative;height:390px}
  .fh-card{position:absolute;width:265px;background:#fff;border-radius:4px;box-shadow:0 26px 50px rgba(0,0,0,.45);padding:10px;transition:transform .4s}
  .fh-card img{display:block;width:100%;height:auto}
  .fh-card:nth-child(1){top:0;right:30px;transform:rotate(4deg)}
  .fh-card:nth-child(2){top:115px;right:150px;transform:rotate(-5deg);z-index:2}
  .fh-card:nth-child(3){top:215px;right:10px;transform:rotate(2deg);z-index:3}
  .fh-art:hover .fh-card:nth-child(1){transform:rotate(6deg) translateY(-6px)}
  .fh-art:hover .fh-card:nth-child(2){transform:rotate(-7deg) translateY(-6px)}
  .fh-art:hover .fh-card:nth-child(3){transform:rotate(3deg) translateY(-6px)}
  .fh-ind{position:relative;background:#0d2615;border-top:1px solid rgba(255,255,255,.08)}
  .fh-ind-in{max-width:1240px;margin:0 auto;padding:1.6rem 2.4rem 2.4rem;display:flex;gap:1rem;overflow-x:auto;scrollbar-width:none}
  .fh-ind-in::-webkit-scrollbar{display:none}
  .fh-ind a{flex:none;display:flex;align-items:center;gap:.9rem;padding:1rem 1.6rem;border:1px solid rgba(255,255,255,.18);color:#fff;text-decoration:none;font-size:1.4rem;font-weight:600;transition:all .15s;background:rgba(255,255,255,.03)}
  .fh-ind a:hover{border-color:var(--o);background:rgba(224,115,26,.15)}
  .fh-ind a i{width:8px;height:8px;background:var(--o);display:block}
  .fh-ind .lbl{flex:none;align-self:center;font-size:1.15rem;letter-spacing:.16em;text-transform:uppercase;color:#f7c79f;margin-right:.6rem;font-weight:700}
  @media (max-width:989px){
    .fh-in{grid-template-columns:1fr;padding:3.6rem 1.6rem 4rem;gap:0}
    .fh-art{display:none}
    .fh-input{font-size:1.7rem;padding:1.8rem 1rem}
    .fh-box svg{display:none}
    .fh-go{padding:0 1.8rem;font-size:1.5rem}
    .fh-sub{font-size:1.55rem}
    .fh-stats{gap:2.2rem}
    .fh-stats b{font-size:2.4rem}
    .fh-ind-in{padding:1.4rem 1.6rem 2rem}
  }
</style>

<section class="fh" id="fh">
  <div class="fh-bg"></div>
  <div class="fh-in">
    <div>
      <div class="fh-eyebrow"><i></i>{{ section.settings.eyebrow }}</div>
      <h1>{{ section.settings.heading }}</h1>
      <p class="fh-sub">{{ section.settings.subheading }}</p>
      <div class="fh-search">
        <form class="fh-box" action="/search" method="get" role="search" id="fh-form">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
          <input class="fh-input" id="fh-q" name="q" type="search" autocomplete="off" spellcheck="false" aria-label="Describe your site, equipment or hazard" aria-autocomplete="list" aria-controls="fh-dd" placeholder="Describe your site, equipment or hazard">
          <button class="fh-go" type="submit">Find signs</button>
        </form>
        <div class="fh-dd" id="fh-dd" role="listbox"></div>
      </div>
      <div class="fh-try"><span>Try:</span>
        {%- assign ex = section.settings.examples | split: '|' -%}
        {%- for e in ex -%}{%- assign t = e | strip -%}<a href="/search?q={{ t | url_encode }}">{{ t }}</a>{%- endfor -%}
      </div>
      <div class="fh-stats">
        <div><b>{{ section.settings.stat1 }}</b><small>{{ section.settings.stat1_label }}</small></div>
        <div><b>{{ section.settings.stat2 }}</b><small>{{ section.settings.stat2_label }}</small></div>
        <div><b>{{ section.settings.stat3 }}</b><small>{{ section.settings.stat3_label }}</small></div>
      </div>
    </div>
    <div class="fh-art" aria-hidden="true">
      {%- assign shown = 0 -%}
      {%- for h in section.settings.art_handles | split: ',' -%}
        {%- assign p = all_products[h | strip] -%}
        {%- if p.featured_image and shown < 3 -%}
          <a class="fh-card" href="{{ p.url }}" tabindex="-1"><img src="{{ p.featured_image | image_url: width: 600 }}" alt="" width="600" height="{{ 600 | divided_by: p.featured_image.aspect_ratio | round }}" loading="eager"></a>
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if shown < 3 and section.settings.art_collection != blank -%}
        {%- for p in section.settings.art_collection.products limit: 6 -%}
          {%- if shown < 3 and p.featured_image -%}
            <a class="fh-card" href="{{ p.url }}" tabindex="-1"><img src="{{ p.featured_image | image_url: width: 600 }}" alt="" width="600" height="{{ 600 | divided_by: p.featured_image.aspect_ratio | round }}" loading="eager"></a>
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
  <nav class="fh-ind" aria-label="Find signs by industry">
    <div class="fh-ind-in"><span class="lbl">Jump to</span>
      {%- assign inds = section.settings.industries | split: '|' -%}
      {%- for x in inds -%}{%- assign pair = x | split: '=' -%}{%- assign t = pair[0] | strip -%}{%- if pair[1] -%}{%- assign u = pair[1] | strip -%}{%- else -%}{%- assign u = '/search?q=' | append: t -%}{%- endif -%}<a href="{{ u }}"><i></i>{{ t }}</a>{%- endfor -%}
    </div>
    <div class="fh-stripe"></div>
  </nav>
</section>

<script>
(() => {
  const API = {{ section.settings.api_url | json }};
  const SER = { 'DANGER': ['#C8102E', '#fff', '#111'], 'WARNING': ['#F47B20', '#111', '#F47B20'], 'CAUTION': ['#FFD100', '#111', '#FFD100'], 'NOTICE': ['#005EB8', '#fff', '#005EB8'], 'SAFETY FIRST': ['#00843D', '#fff', '#00843D'] };
  const inp = document.getElementById('fh-q'), dd = document.getElementById('fh-dd'), form = document.getElementById('fh-form');
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const cache = new Map(), imgs = new Map();
  let timer, seq = 0, act = -1, items = [];
  const img = (h) => { if (!imgs.has(h)) imgs.set(h, fetch('/products/' + h + '.js').then((r) => (r.ok ? r.json() : null)).then((p) => (p && p.featured_image ? p.featured_image + '?width=160' : null)).catch(() => null)); return imgs.get(h); };
  function go(q) { location.href = '/search?q=' + encodeURIComponent(q); }
  const beacon = (a) => { try { if (!a || !a.dataset.sku) return; const b = JSON.stringify({ action: 'click', q: inp.value.trim(), sku: a.dataset.sku, kind: 'suggest' }); if (!(navigator.sendBeacon && navigator.sendBeacon(API, b))) fetch(API, { method: 'POST', body: b, keepalive: true }).catch(() => {}); } catch (e) {} };
  dd.addEventListener('click', (e) => beacon(e.target.closest('a[data-sku]')));
  function render(q, d) {
    const rows = d.results || [];
    const s = rows.map((r, i) => {
      const c = SER[r.series] || SER.NOTICE;
      const lines = (r.lines || []).filter((l) => l && l.toUpperCase() !== r.series).slice(0, 4).map(esc).join('<br>');
      return `<a href="/products/${encodeURIComponent(r.handle)}" role="option" data-i="${i}" data-sku="${esc(r.sku)}"><span class="fh-th"><span class="h" style="background:${c[2]};color:${c[0] === '#C8102E' ? '#fff' : c[1]}">${esc(r.series)}</span><span class="b">${lines}</span><img alt="" data-h="${esc(r.handle)}"></span><span class="fh-tx"><b>${esc(r.subject)}</b><small>${esc(r.sector || '')}${r.install_point ? ' · ' + esc(r.install_point) : ''}</small></span><span class="fh-tg" style="background:${c[0]};color:${c[1]}">${esc(r.series)}</span></a>`;
    }).join('');
    const all = `<a class="all" href="/search?q=${encodeURIComponent(q)}" data-i="${rows.length}"><span>${rows.length ? 'See every sign for' : 'Search all signs for'} “${esc(q)}”</span><span>${d.total >= 500 ? '500+' : (d.total || '')} →</span></a>`;
    dd.innerHTML = (rows.length ? s : `<div class="hint">Keep typing, or press Enter to search by meaning.</div>`) + all;
    items = [...dd.querySelectorAll('a')]; act = -1; dd.classList.add('on');
    dd.querySelectorAll('img[data-h]').forEach((im) => img(im.dataset.h).then((u) => { if (u) { im.onload = () => im.classList.add('ok'); im.src = u; } }));
  }
  async function suggest() {
    const q = inp.value.trim();
    if (q.length < 2) { dd.classList.remove('on'); return; }
    const my = ++seq;
    let d = cache.get(q);
    if (!d) { try { const r = await fetch(API + '?action=suggest&q=' + encodeURIComponent(q)); d = await r.json(); cache.set(q, d); } catch (e) { return; } }
    if (my === seq && inp.value.trim() === q) render(q, d);
  }
  inp.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(suggest, 140); });
  inp.addEventListener('focus', () => { if (inp.value.trim().length >= 2) suggest(); });
  inp.addEventListener('keydown', (e) => {
    if (!dd.classList.contains('on') || !items.length) return;
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault(); act = (act + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length;
      items.forEach((a, i) => a.classList.toggle('act', i === act));
    } else if (e.key === 'Enter' && act >= 0) { e.preventDefault(); beacon(items[act]); location.href = items[act].href; }
    else if (e.key === 'Escape') dd.classList.remove('on');
  });
  document.addEventListener('click', (e) => { if (!e.target.closest('.fh-search')) dd.classList.remove('on'); });
  form.addEventListener('submit', (e) => { e.preventDefault(); const q = inp.value.trim(); if (q) go(q); else inp.focus(); });
  fetch(API + '?q=__warm__').catch(() => {});
  const ph = {{ section.settings.placeholders | split: '|' | json }};
  let pi = 0, pc = 0, del = false;
  (function tick() {
    if (document.activeElement === inp || inp.value) { setTimeout(tick, 700); return; }
    const t = (ph[pi] || '').trim(); pc += del ? -1 : 1; inp.setAttribute('placeholder', t.slice(0, pc));
    if (!del && pc >= t.length) { del = true; setTimeout(tick, 1900); return; }
    if (del && pc <= 0) { del = false; pi = (pi + 1) % ph.length; }
    setTimeout(tick, del ? 22 : 52);
  })();
})();
</script>

{% schema %}
{
  "name": "CGAP Finder Hero",
  "tag": "section",
  "class": "cgap-finder-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The CGAP Sign Finder" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Signs for the hazards nobody else makes signs for" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Tell us your industry, machine, room or hazard in plain words. We search every sign we make and show the exact ones for your site." },
    { "type": "text", "id": "examples", "label": "Example searches (|)", "default": "grain bin entry|commercial kitchen fryers|forklift battery charging|lift station wet well|arc flash at the panel" },
    { "type": "textarea", "id": "industries", "label": "Industry quick links (Label=URL, separated by |)", "default": "Water & Wastewater=/pages/industry-water-wastewater-utilities|Hospitals, Imaging & Labs=/pages/industry-healthcare-imaging-labs|Marinas & Waterfront=/pages/industry-marinas-waterfront|Warehousing & Logistics=/pages/industry-warehousing-logistics|Metal & Fab Shops=/pages/metal-fabrication-foundry-safety-signs|Batteries & EV=/pages/lithium-battery-energy-storage-ev-safety-signs|Property & Campuses=/pages/industry-property-management-multifamily|Parks, Ranges & Venues=/pages/park-shooting-range-venue-safety-signs|Construction=/pages/construction-site-safety-signs|Chemical Plants=/pages/chemical-plant-storage-safety-signs|Mining & Quarries=/pages/mining-quarry-asphalt-plant-safety-signs|Oil, Gas & Hydrogen=/pages/oil-gas-hydrogen-safety-signs|Electric & Telecom=/pages/industry-electric-telecom-utilities|Public Works=/pages/industry-municipalities-public-works|Manufacturing Plants=/pages/industry-manufacturing-industrial-plants|Farms & Grain=/pages/farm-grain-feed-safety-signs|Restaurants & Kitchens=/pages/restaurant-commercial-kitchen-safety-signs|Food Processing=/pages/food-processing-plant-safety-signs|Cold Storage & Ammonia=/pages/cold-storage-ammonia-refrigeration-safety-signs|Auto & Tire Shops=/pages/auto-repair-shop-safety-signs|Waste & Recycling=/pages/waste-recycling-transfer-station-safety-signs|Sawmills & Paper Mills=/pages/sawmill-pulp-paper-mill-safety-signs|Propane & Natural Gas=/pages/propane-natural-gas-pipeline-safety-signs|Schools & Theaters=/pages/school-shop-class-theater-safety-signs|Data Centers=/pages/data-center-server-room-safety-signs|Labs & Pharma=/pages/laboratory-biotech-pharma-safety-signs|Car Washes=/pages/car-wash-safety-signs|Breweries & Wineries=/pages/brewery-winery-safety-signs" },
    { "type": "text", "id": "placeholders", "label": "Animated placeholder phrases (|)", "default": "Grain bin roof manhole on our farm|Lockout on a meat grinder|Battery charging room for forklifts|Confined space at a lift station|Hot oil fryers in a restaurant kitchen" },
    { "type": "text", "id": "stat1", "label": "Stat 1", "default": "87,000+" },
    { "type": "text", "id": "stat1_label", "label": "Stat 1 label", "default": "Hazard-specific signs" },
    { "type": "text", "id": "stat2", "label": "Stat 2", "default": "111" },
    { "type": "text", "id": "stat2_label", "label": "Stat 2 label", "default": "Industries covered" },
    { "type": "text", "id": "stat3", "label": "Stat 3", "default": "USA" },
    { "type": "text", "id": "stat3_label", "label": "Stat 3 label", "default": "Made on .065 aluminum" },
    { "type": "text", "id": "art_handles", "label": "Product handles for the sign collage (comma separated)" },
    { "type": "collection", "id": "art_collection", "label": "Fallback collection for the sign collage" },
    { "type": "text", "id": "api_url", "label": "Search API URL", "default": "https://esmwoaqemeukjrjaesby.supabase.co/functions/v1/sign-finder" }
  ],
  "presets": [{ "name": "CGAP Finder Hero" }]
}
{% endschema %}
